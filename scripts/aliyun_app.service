[Unit]
Description=School Market Web (Flask)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@APP_DIR@
Environment=FLASK_HOST=0.0.0.0
Environment=FLASK_PORT=@FLASK_PORT@
# 如需通过环境变量注入密钥（推荐，可覆盖 config.py 里的默认值），取消注释并填写：
# Environment=DEEPSEEK_API_KEY=sk-xxxx
# Environment=SCHOOL_MARKET_SECRET_KEY=xxxx
ExecStart=@APP_DIR@/pa.venv/bin/python @APP_DIR@/backend/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
