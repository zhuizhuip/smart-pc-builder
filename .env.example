# 环境变量模板：复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，切勿提交到 git。

# DeepSeek API Key（智能装机对话功能；未配置则退回本地兜底逻辑）
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥

# 淘宝登录 Cookie（可选，仅 collectors/pa2.py 爬虫使用）
TAOBAO_COOKIE=你的淘宝Cookie

# 生产环境密钥（用 `python -c "import secrets; print(secrets.token_hex(32))"` 生成）
SECRET_KEY=请生成随机值
JWT_SECRET_KEY=请生成随机值
SCHOOL_MARKET_SECRET_KEY=请生成随机值
